# =============================================================
# TaskFlow SaaS — Production Environment Variables
# =============================================================

# Server Port (Auto-injected by Railway / Render / Fly.io)
PORT=3000
NODE_ENV=production

# -------------------------------------------------------------
# Supabase PostgreSQL Cloud Database Configuration
# -------------------------------------------------------------
# Transaction / Session Mode Connection Pooler (Port 6543 or 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Direct Connection URL (Used for Prisma migrations & db push)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# -------------------------------------------------------------
# Authentication (Clerk)
# -------------------------------------------------------------
# Get from your Clerk Dashboard: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_live_..."

# -------------------------------------------------------------
# Security & CORS
# -------------------------------------------------------------
CORS_ORIGIN="*"
